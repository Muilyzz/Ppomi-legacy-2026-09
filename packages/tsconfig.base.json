{
  // Shared by every package under packages/. Node globals (URL, timers) come from
  // @types/node; no package relies on the DOM lib. typeRoots covers both installs:
  // `npm ci` in packages/ppomi-body (nested) and a root `npm ci` (hoisted).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["./ppomi-body/node_modules/@types", "../node_modules/@types"]
  }
}
