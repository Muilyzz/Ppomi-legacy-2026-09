{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppomi.muilyzz.com/schemas/ppomi-path.schema.json",
  "title": "Ppomi path document v1",
  "description": "Versioned path catalog entry. Domain playbook-* packs absorb into this JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "surface", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "surface": {
      "enum": ["os-windows", "os-macos", "os-android", "iphone-mirroring", "page"]
    },
    "legacyPackage": { "type": "string", "minLength": 1 },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "focus",
            "click",
            "type",
            "read",
            "goto",
            "fill",
            "waitFor",
            "human",
            "payment",
            "submit"
          ]
        },
        "target": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["navigate", "input", "commit"] },
        "require": { "$ref": "#/$defs/require" }
      }
    },
    "require": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permission": { "enum": ["ui.read", "ui.control"] },
        "screen": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "focused": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "text": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "wait": { "type": "integer", "exclusiveMinimum": 0 }
      }
    }
  }
}
