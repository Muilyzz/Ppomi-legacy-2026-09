{
  "name": "ppomi-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:playbooks": "node scripts/generate-playbooks.mjs",
    "generate:theme": "node scripts/generate-theme.mjs",
    "build": "npm run generate:theme && npm run generate:playbooks && tsc --noEmit && vite build && node scripts/copy-assets.mjs",
    "build:shell": "npm run generate:theme && npm run generate:playbooks && tsc --noEmit && vite build --config vite.shell.config.ts",
    "test": "npm run generate:playbooks && node --test scripts/*.test.mjs && tsx --test src/*.test.ts server/*.test.ts && npm run test:browser",
    "dev": "npm run generate:theme && npm run generate:playbooks && vite --host 127.0.0.1",
    "test:browser": "node --conditions=browser --import tsx --test src/browser-stop.check.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.65",
    "@ai-sdk/react": "^4.0.100",
    "@openai/agents": "0.17.2",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@tauri-apps/api": "^2.11.1",
    "ai": "^7.0.97",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
