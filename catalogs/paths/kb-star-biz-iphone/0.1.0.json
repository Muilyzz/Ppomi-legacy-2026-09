{
  "schemaVersion": 1,
  "id": "kb-star-biz-iphone",
  "version": "0.1.0",
  "title": "KB스타기업뱅킹 iPhone 사업자 계좌번호 조회",
  "surface": "iphone-mirroring",
  "steps": [
    {
      "id": "go-home",
      "title": "cold start만: phone_key home (⌘1 → SpringBoard). pause/resume(fromStep)은 건너뜀",
      "kind": "key",
      "target": "home",
      "effect": "navigate"
    },
    {
      "id": "open-kb",
      "title": "KB스타기업뱅킹이 화면에 있는지 확인 (focus는 앱을 실행하지 않음; 앱 열기·로그인은 당사자)",
      "kind": "focus",
      "target": "KB스타기업뱅킹"
    },
    {
      "id": "human-login",
      "title": "KB스타기업뱅킹 로그인은 당사자",
      "kind": "human"
    },
    {
      "id": "open-accounts",
      "title": "계좌조회",
      "kind": "click",
      "target": "계좌조회",
      "effect": "navigate",
      "require": {
        "wait": 15000
      }
    },
    {
      "id": "human-account-detail",
      "title": "쓸 계좌 하나의 상세 화면은 당사자 (목록에서 추정 금지)",
      "kind": "human"
    },
    {
      "id": "read-account",
      "title": "계좌번호 읽기 (원문은 StepResult에 남기지 않음)",
      "kind": "read",
      "require": {
        "permission": "ui.read",
        "screen": ["계좌번호"],
        "wait": 15000
      }
    }
  ]
}
